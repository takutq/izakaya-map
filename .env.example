# ============================================================================
# 居酒屋開拓マップ - 環境変数テンプレート
# ============================================================================
# ※ 未設定のまま起動すると、自動的に「ローカルモード（モック初期データ + localStorage）」で動作します。
# ※ Supabaseと接続する場合は、`.env.local` にコピーして以下の値を設定してください。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ※（任意）店名検索でAI（Google Gemini API）による高度な居酒屋特定・ジャンル/名物自動補完も併用する場合
GEMINI_API_KEY=
